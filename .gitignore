# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.so.*
*.dylib
bin/

# llama.cpp binaries (drivers/llama: make setup)
drivers/llama/vendor/
third_party/

# Downloaded archives
llama-*.tar.gz

# Model weights & blobs (local only — use: make -C drivers/llama link-ollama)
*.gguf
*.bin

# Model directories (keep .gitkeep placeholders)
/models/*
!/models/.gitkeep

/drivers/llama/models/ollama/*
!/drivers/llama/models/ollama/.gitkeep
/drivers/llama/models/*.gguf
/drivers/llama/models/*.bin

# Generated by drivers/llama/scripts/link-ollama.sh
**/models/ollama/manifest.json

# Local Wuji config (driver endpoints, overrides)
.wuji/

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# env file
.env

# Editor/IDE
# .idea/
# .vscode/
