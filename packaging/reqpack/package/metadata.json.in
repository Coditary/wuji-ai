{
  "formatVersion": 1,
  "name": "wuji",
  "indexName": "wuji-ai-cli",
  "version": @VERSION@,
  "release": 1,
  "revision": 0,
  "summary": "Unified AI CLI",
  "description": "wuji — CLI frontend for AI workloads via the Wuji core daemon.",
  "license": "MIT",
  "architecture": @ARCHITECTURE@,
  "system": [@SYSTEM@],
  "vendor": "Coditary",
  "maintainerEmail": "Matographo@gmail.com",
  "url": @URL@,
  "homepage": "https://github.com/Coditary/wuji-ai",
  "sourceUrl": "https://github.com/Coditary/wuji-ai",
  "buildDate": @BUILD_DATE@,
  "tags": ["cli", "ai", "wuji"],
  "payload": {
    "path": "payload/payload.tar.zst",
    "archive": "tar",
    "compression": "zstd",
    "hashAlgorithm": "sha256",
    "hashFile": "hashes/payload.sha256",
    "sizeCompressed": @SIZE_COMPRESSED@,
    "sizeInstalledExpected": @SIZE_INSTALLED_EXPECTED@
  }
}
